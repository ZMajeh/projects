# ~/.cshrc.preprompt - Pre-prompt (first line) for two-line prompt
# This is sourced from ~/.cshrc and prints the first line before each prompt

# Define colors (raw ANSI codes via printf, for echo -n)
set _gray = "`printf '\033[0;90m'`"
set _green = "`printf '\033[1;32m'`"
set _cyan = "`printf '\033[1;36m'`"
set _yellow = "`printf '\033[1;33m'`"
set _magenta = "`printf '\033[1;35m'`"
set _reset = "`printf '\033[0m'`"

# Pre-prompt function - prints first line: ┌─[time] user@host:path (gitbranch)
alias _precmd_preprompt 'set _gitbr = `sh -c "git symbolic-ref --short HEAD 2>/dev/null"`; set _t = `date +%H:%M:%S`; echo -n "${_gray}┌─[$_t]${_reset} ${_green}$USER${_reset}${_gray}@${_reset}${_cyan}$HOST${_reset}${_gray}:${_reset}${_yellow}$cwd${_reset}"; if ("$_gitbr" != "") echo -n " ${_gray}(${_reset}${_magenta}$_gitbr${_reset}${_gray})${_reset}"; echo ""'